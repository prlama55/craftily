{
  "compilerOptions": {
    "target": "ES5",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["dom", "esnext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*", "global.d.ts"],
  "exclude": ["node_modules"]
}
