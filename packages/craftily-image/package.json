{
  "name": "@craftily/image",
  "version": "0.1.6",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "Craftily UI",
  "description": "A lightweight image filter utility for canvas using TypeScript.",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./editor": {
      "import": "./dist/ImageEditor.js",
      "require": "./dist/ImageEditor.cjs",
      "types": "./dist/components/index.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "clean": "rm -rf dist",
    "publish:prepare": "npm run clean && npm run build",
    "stable:publish": "npm run publish:prepare && npm publish --access public",
    "beta:publish": "npm run publish:prepare && npm publish --tag beta --access public"
  },
  "keywords": [
    "canvas",
    "image-filters",
    "typescript",
    "image-processing",
    "web",
    "lit"
  ],
  "dependencies": {
    "lit": "^3.3.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "rollup-plugin-lit-css": "^5.0.2"
  }
}
